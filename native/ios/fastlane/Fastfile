default_platform(:ios)

platform :ios do
  desc "Sign, archive, and upload a TestFlight build"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: ENV["APP_STORE_CONNECT_API_KEY_IS_BASE64"] == "true",
      in_house: false
    )

    team_id = ENV.fetch("APPLE_TEAM_ID")
    profile_name = ENV.fetch("IOS_PROFILE_NAME")
    profile_uuid = ENV.fetch("IOS_PROFILE_UUID")
    app_url = ENV.fetch("AETHER_APP_URL")
    build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")

    increment_build_number(
      xcodeproj: "Aether.xcodeproj",
      build_number: build_number
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Aether.xcodeproj",
      team_id: team_id,
      bundle_identifier: "app.aether.tracker",
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["Aether"]
    )

    gym(
      project: "Aether.xcodeproj",
      scheme: "Aether",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_team_id: team_id,
      output_directory: "build/testflight",
      output_name: "AETHER",
      xcargs: [
        "DEVELOPMENT_TEAM=#{team_id}",
        "CODE_SIGN_STYLE=Manual",
        'CODE_SIGN_IDENTITY="Apple Distribution"',
        "PROVISIONING_PROFILE=#{profile_uuid}",
        "AETHER_APP_URL=#{app_url}",
        "CURRENT_PROJECT_VERSION=#{build_number}"
      ].join(" "),
      export_options: {
        method: "app-store",
        teamID: team_id,
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        compileBitcode: false,
        provisioningProfiles: {
          "app.aether.tracker" => profile_name
        }
      }
    )

    notes = ENV["TESTFLIGHT_CHANGELOG"] || "AETHER live UAP console beta #{build_number}."
    groups = (ENV["TESTFLIGHT_GROUPS"] || "").split(",").map(&:strip).reject(&:empty?)

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/testflight/AETHER.ipa",
      skip_waiting_for_build_processing: groups.empty?,
      distribute_external: groups.any?,
      groups: groups.empty? ? nil : groups,
      changelog: notes
    )
  end
end
